# LLM (endpoint OpenAI-compatible). Copy file này thành .env rồi điền.
# .env đã được .gitignore, KHÔNG commit key vào repo.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding: bge-m3 chạy local (cần torch) hoặc gọi endpoint /v1/embeddings.
#   local -> tải BAAI/bge-m3 về máy (~2.2GB) qua sentence-transformers
#   api   -> endpoint OpenAI-compatible của bạn phục vụ BAAI/bge-m3
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-m3
# EMBED_BASE_URL=
# EMBED_API_KEY=
